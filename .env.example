# Environment configuration for Antigravity Mobile IDE
# Copy this file to `.env`: cp .env.example .env

# 1. Workspace directory exposed to the mobile app (defaults to current project or /home/realriga/development/me)
AGY_WORKSPACE_DIR=/home/realriga/development/me/antigravity-mobile-ide

# 2. Ollama endpoint (use http://localhost:11434 locally, or your new PC's Tailscale IP e.g. http://100.x.y.z:11434)
OLLAMA_BASE_URL=http://localhost:11434

# 3. Optional Google AI Studio Gemini API Key (https://aistudio.google.com/app/api-keys)
GEMINI_API_KEY=

# 4. Optional Remote Access PIN (Set this when deploying to Cloud Run / Railway / Cloudflare Tunnel)
AGY_ACCESS_PIN=
